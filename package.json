{
  "name": "glint",
  "version": "0.2.0",
  "description": "Holographic prompts for AI coding agents. An MCP server pops a translucent TUI over your desktop and returns the answer.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "glint": "./dist/cli.js"
  },
  "main": "dist/electron/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "start": "npm run build && electron .",
    "demo": "npm run build && node dist/cli.js demo",
    "glint": "node --import tsx src/cli.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "electron": "^45.3.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2"
  }
}
