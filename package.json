{
  "name": "glint",
  "version": "0.3.1",
  "private": true,
  "description": "Holographic prompts for AI coding agents. An MCP server pops a translucent TUI over your desktop and returns the answer.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "claude-code",
    "codex",
    "antigravity",
    "opencode",
    "overlay",
    "electron",
    "notifications",
    "hooks",
    "cyberpunk"
  ],
  "author": "Kutay Karahan",
  "homepage": "https://github.com/Blitz00X/glint#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Blitz00X/glint.git"
  },
  "bugs": {
    "url": "https://github.com/Blitz00X/glint/issues"
  },
  "type": "module",
  "license": "MIT",
  "bin": {
    "glint": "./dist/cli.js"
  },
  "main": "dist/electron/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "postbuild": "node -e \"require('fs').chmodSync('dist/cli.js', 0o755)\"",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "start": "npm run build && electron .",
    "demo": "npm run build && node dist/cli.js demo",
    "glint": "node --import tsx src/cli.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "electron": "^45.3.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2"
  },
  "files": [
    "dist/",
    "overlay/",
    "plugins/",
    "skills/",
    "src/electron/preload.cjs",
    "src/electron/picker-preload.cjs",
    "README.md",
    "LICENSE"
  ]
}
